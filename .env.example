DIRECT_URL="postgresql://neondb_owner:password@ep-wild-night-az8ymtjf.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Auth (Better Auth) & Data API Endpoints
NEON_AUTH_URL="https://ep-wild-night-az8ymtjf.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth"
NEON_JWKS_URL="https://ep-wild-night-az8ymtjf.neonauth.c-3.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_DATA_API_URL="https://ep-wild-night-az8ymtjf.apirest.c-3.ap-southeast-1.aws.neon.tech/neondb/rest/v1"

# NestJS Auth & Session Secrets
