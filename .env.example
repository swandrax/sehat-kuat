# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NestJS Auth & Session Secrets
JWT_SECRET="your_secure_jwt_secret_here"
SESSION_SECRET="your_secure_session_secret_here"

# AI Service (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
PORT=4000
